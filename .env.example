# MUTAGEN Environment Configuration
# Copy this file to .env and fill in the values.
# Environment variables take precedence over .env values.

# ─── AI Provider (Local Gemma) ─────────────────────────────
MUTAGEN_AI_PROVIDER=gemma
MUTAGEN_AI_MODEL=gemma4:e4b
GEMMA_BASE_URL=http://localhost:11434
# GEMMA_API_KEY=your-api-key-if-remote-authenticated
# GEMMA_TIMEOUT=120

# Optional Cloud Providers (Legacy / Secondary)
# GEMINI_API_KEY=your-gemini-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# ─── Database ──────────────────────────────────────────────
MUTAGEN_DATABASE_URL=postgresql+psycopg://mutagen:mutagen@localhost:5432/mutagen

# ─── Redis ─────────────────────────────────────────────────
MUTAGEN_REDIS_URL=redis://localhost:6379/0

# ─── Logging ───────────────────────────────────────────────
MUTAGEN_LOG_LEVEL=INFO

# ─── Artifacts ─────────────────────────────────────────────
MUTAGEN_ARTIFACT_DIR=./artifacts

# ─── Evolution Defaults ────────────────────────────────────
MUTAGEN_MAX_GENERATIONS=5
MUTAGEN_POPULATION_SIZE=4
MUTAGEN_BENCHMARK_REPETITIONS=5
MUTAGEN_EXECUTION_TIMEOUT=30
MUTAGEN_MEMORY_LIMIT=256
MUTAGEN_MAX_SOURCE_SIZE=1048576
MUTAGEN_MAX_CANDIDATES_PER_GENERATION=6

# ─── Sandbox ───────────────────────────────────────────────
MUTAGEN_SANDBOX_IMAGE=python:3.11-slim
MUTAGEN_SANDBOX_NETWORK_DISABLED=true
MUTAGEN_SANDBOX_CPU_QUOTA=50000
MUTAGEN_SANDBOX_MEMORY_LIMIT=268435456
MUTAGEN_SANDBOX_PIDS_LIMIT=64
